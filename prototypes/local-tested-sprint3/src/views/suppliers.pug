extends layout
block content
  .heading-row
    div
      p.eyebrow PARTNERS
      h1 Suppliers
      p.muted Supplier records and their linked products from MySQL.
    span.pill #{items.length} #{items.length === 1 ? 'supplier' : 'suppliers'}
  section.panel
    if items.length
      .table-wrap(tabindex="0" role="region" aria-label="Supplier directory")
        table
          thead
            tr
              th(scope="col") Supplier
              th(scope="col") Email
              th(scope="col") Phone
              th(scope="col") Address
              th(scope="col") Products
          tbody
            each s in items
              tr
                td.strong= s.name
                td= s.email || '—'
                td= s.phone || '—'
                td= s.address || '—'
                td
                  span.pill= s.product_count
    else
      .empty No suppliers available.
