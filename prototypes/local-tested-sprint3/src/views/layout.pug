doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title #{title} | StockWise
    link(rel="stylesheet" href="/static/css/style.css")
  body
    a.skip-link(href="#main-content") Skip to main content
    .shell
      aside.sidebar
        a.brand(href="/")
          span.brand-mark SW
          span StockWise
        p.sidebar-caption INVENTORY WORKSPACE
        nav(aria-label="Main navigation")
          a(class=active === 'dashboard' ? 'nav-active' : '' aria-current=active === 'dashboard' ? 'page' : null href="/")
            span(aria-hidden="true") ◫
            |  Dashboard
          a(class=active === 'products' || active === 'product-detail' ? 'nav-active' : '' aria-current=active === 'products' ? 'page' : active === 'product-detail' ? 'location' : null href="/products")
            span(aria-hidden="true") ▦
            |  Products
          a(class=active === 'suppliers' ? 'nav-active' : '' aria-current=active === 'suppliers' ? 'page' : null href="/suppliers")
            span(aria-hidden="true") ♙
            |  Suppliers
          a(class=active === 'movements' ? 'nav-active' : '' aria-current=active === 'movements' ? 'page' : null href="/movements")
            span(aria-hidden="true") ↔
            |  Movements
        .sidebar-bottom
          span.pulse
          |  Sprint 3 · Read-only prototype
      main#main-content.main(tabindex="-1")
        header.topbar
          .breadcrumb StockWise / #{title}
          .user-badge Demo inventory workspace
        .content
          block content
        footer.footer Built with Node.js · Express · Pug · MySQL | Sprint 3 prototype
