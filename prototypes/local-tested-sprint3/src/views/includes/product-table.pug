if items.length
  .table-wrap(tabindex="0" role="region" aria-label="Product catalogue")
    table
      thead
        tr
          th(scope="col") Product
          th(scope="col") SKU
          th(scope="col") Supplier
          th(scope="col") Stock
          th(scope="col") Reorder
          th(scope="col") Price
          th(scope="col") Status
      tbody
        each item in items
          tr
            td
              a.product-link(href='/products/' + item.id)= item.name
            td.mono= item.sku
            td= item.supplier_name || 'Unassigned'
            td.strong= item.quantity
            td= item.reorder_level
            td= money(item.price)
            td
              if item.quantity <= item.reorder_level
                span.tag.tag-warn Low stock
              else
                span.tag.tag-good Healthy
else
  .empty No products match your filters.
